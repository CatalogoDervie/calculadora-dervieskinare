const SPREADSHEET_ID = '18K0DbRbM9ztIzfTmUIAzAUltrsff96dfjaCcNiLCnVE';
const SHEETS={CONFIG:'Configuracion',CATALOGO:'CatalogoDervie',PRODUCTOS:'Productos',PACIENTES:'Pacientes',COMPRAS:'Compras',VENTAS:'Ventas',DETALLE:'DetalleVentas',PAGOS:'Pagos',MOV:'MovimientosStock'};
const HEADERS={
Configuracion:['Campo','Valor'],
CatalogoDervie:['ID_PRODUCTO','CODIGO','PRODUCTO','DESCRIPCION','CATEGORIA','PRECIO_COMPRA_REVENTA','PRECIO_VENTA_SUGERIDO','PRECIO_VENTA_PROPIO','STOCK_ACTUAL','ACTIVO','CANT_DESC_1','DESC_1','CANT_DESC_2','DESC_2','FECHA_ACTUALIZACION'],
Productos:['ID_PRODUCTO','CODIGO','PRODUCTO','DESCRIPCION','CATEGORIA','PRECIO_COMPRA_REVENTA','PRECIO_VENTA_SUGERIDO','PRECIO_VENTA_PROPIO','STOCK_ACTUAL','ACTIVO','CANT_DESC_1','DESC_1','CANT_DESC_2','DESC_2','FECHA_ACTUALIZACION'],
