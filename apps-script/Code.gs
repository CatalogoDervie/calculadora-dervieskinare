Ventas:['ID_VENTA','FECHA','ID_PACIENTE','PACIENTE','TOTAL_BRUTO','DESCUENTO_TOTAL','TOTAL_FINAL','TOTAL_PAGADO','SALDO','ESTADO','FORMA_PAGO','OBSERVACIONES'],
